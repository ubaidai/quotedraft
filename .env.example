# Anthropic API key (https://console.anthropic.com). Required for extraction and matching.
ANTHROPIC_API_KEY=

# Or use OpenRouter instead (same Claude models, same prices). Leave ANTHROPIC_API_KEY empty.
OPENROUTER_API_KEY=
# QD_PROVIDER=openrouter   # auto-detected when only OPENROUTER_API_KEY is set

# Catalog store: local (in-process, no server) or postgres (pgvector)
QD_STORE=local
DATABASE_URL=postgresql://quotedraft:quotedraft@localhost:5433/quotedraft

# Odoo: mock (JSON file in data/) or xmlrpc (real Odoo 17)
ODOO_BACKEND=mock
ODOO_URL=http://localhost:8069
ODOO_DB=quotedraft
ODOO_USER=admin
ODOO_PASSWORD=

# Routing: haiku_first | haiku_only | sonnet_only
QD_ROUTING=haiku_first
QD_CONFIDENCE_THRESHOLD=0.6
QD_DAILY_BUDGET_USD=2.0
QD_KEYWORD_WEIGHT=5
